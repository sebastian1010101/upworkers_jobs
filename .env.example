NODE_ENV=development
PORT=3000
HOST=127.0.0.1
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_DB=upwork_job_radar
DATABASE_URL=postgresql://radar:change-me-for-local-development@localhost:5432/upwork_job_radar?schema=public

# Required only when using the official Upwork API. Obtain an approved key first.
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=http://127.0.0.1:3001/callback
UPWORK_ACCESS_TOKEN=
UPWORK_REFRESH_TOKEN=
# Optional; when absent, Upwork uses the user's default organization.
UPWORK_TENANT_ID=
UPWORK_CACHE_SWEEP_MINUTES=15
UPWORK_TIMEOUT_MS=10000

# Deterministic filters applied before AI analysis.
JOB_FILTER_MIN_FIXED_BUDGET_USD=100
JOB_FILTER_MIN_HOURLY_RATE_USD=10

# Optional. When omitted, imports work but AI analysis is skipped.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_TIMEOUT_MS=30000

# Retries for transient network, rate-limit, and 5xx failures.
EXTERNAL_RETRY_ATTEMPTS=3
EXTERNAL_RETRY_BASE_DELAY_MS=250

# Final scoring threshold used to mark an analysis for notification.
JOB_NOTIFY_SCORE_THRESHOLD=8

# WhatsApp Business Cloud API. Create and approve this template in WhatsApp Manager.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_RECIPIENT_PHONE_NUMBER=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_NAME=upwork_job_alert
WHATSAPP_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TIMEOUT_MS=15000
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
